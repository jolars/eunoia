{
  "$schema": "https://raw.githubusercontent.com/jolars/versionary/main/schemas/config.json",
  "version": 1,
  "review-mode": "pr",
  "release-type": "rust",
  "allow-stable-major": true,
  "include-commit-authors": true,
  "release-reference-comments": "best-effort",
  "packages": {
    ".": {
      "exclude-paths": [
        "ts/",
        "web/"
      ]
    },
    "ts": {
      "release-type": "node",
      "package-name": "eunoia-npm",
      "follows": [
        "."
      ]
    }
  },
  "commit-overrides": {
    "4ce7e8b31c4669dcf002b83ad7900eee4e8fe173": {
      "message": "docs: move site to diplodocus"
    }
  }
}
