{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/site.mjs build",
    "preview": "wrangler dev --local --infer-origin-from-routes=false --config cloudflare/wrangler.jsonc",
    "check": "svelte-check --tsconfig ./tsconfig.json && node scripts/site.mjs check",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "docs:extract": "node scripts/site.mjs extract",
    "docs:packages": "node scripts/site.mjs build",
    "test:docs": "node --test scripts/site.test.mjs && node scripts/check-site.mjs",
    "test:markdown": "node --test scripts/markdown.test.mjs",
    "test:members": "node --experimental-wasm-modules --test src/lib/member-layout.test.mjs",
    "format": "prettier --write \"src/**/*.svelte\"",
    "format:check": "prettier --check \"src/**/*.svelte\"",
    "docs:python": "node scripts/site.mjs build",
    "docs:julia": "node scripts/site.mjs build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-wasm": "^3.5.0",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@jolars/eunoia": "link:../npm",
    "esbuild": "^0.28.2",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "devalue": "5.9.4",
      "dompurify": "3.4.17",
      "fflate": "0.8.3",
      "postcss-selector-parser": "7.1.6",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici": "7.30.1",
      "uuid": "11.1.1"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
