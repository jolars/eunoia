{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/docs.mjs && vite dev",
    "build": "node scripts/docs.mjs && vite build && node scripts/build-markdown.mjs && node scripts/check-docs.mjs --built",
    "preview": "vite preview",
    "check": "node scripts/docs.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "docs:python": "node scripts/python-docs.mjs",
    "test:python-docs": "node --test scripts/python-docs.test.mjs && node scripts/python-docs.mjs && node scripts/check-python-docs.mjs",
    "test:markdown": "node --test scripts/markdown.test.mjs",
    "test:members": "node --experimental-wasm-modules --test src/lib/member-layout.test.mjs",
    "format": "prettier --write \"**/*.svelte\"",
    "format:check": "prettier --check \"**/*.svelte\"",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "docs:julia": "node scripts/julia-docs.mjs",
    "docs:packages": "node scripts/docs.mjs",
    "test:docs": "node --test scripts/python-docs.test.mjs scripts/julia-docs.test.mjs && node scripts/docs.mjs && node scripts/check-docs.mjs",
    "test:julia-docs": "node --test scripts/julia-docs.test.mjs && node scripts/julia-docs.mjs && node scripts/check-docs.mjs --julia"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/utils": "^3.1.7",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^26.6.6",
    "d3": "^7.9.0",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rehype-slug": "^6.0.0",
    "rollup": "^4.67.3",
    "shiki": "^4.5.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.12",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@jolars/eunoia": "link:../npm",
    "esbuild": "^0.28.2",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "devalue": "5.9.4",
      "dompurify": "3.4.17",
      "fflate": "0.8.3",
      "postcss-selector-parser": "7.1.6",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici": "7.30.1",
      "uuid": "11.1.1"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
