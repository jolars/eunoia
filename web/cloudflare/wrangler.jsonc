{
  "name": "eunoia-markdown",
  "main": "./markdown-worker.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "route": {
    "pattern": "eunoia.bz/*",
    "zone_name": "eunoia.bz"
  }
}
